{
  "authorityVersion": 3,
  "canonicalMigrationPath": "server/migrations/0000_canonical_launch_baseline.sql",
  "activeMigrationDirectory": "server/migrations",
  "archivedMigrationDirectory": "server/migrations/_archived/pre-canonical-baseline",
  "canonicalDrizzleSchemaRoots": [
    "drizzle/schema",
    "drizzle/schema/canonical-model-inventory.json"
  ],
  "migrationRunner": "server/migrations/runSqlMigrations.ts",
  "migrationManifest": "server/migrations/manifest.json",
  "migrationLedger": "sql_migration_history",
  "migrationAttemptLedger": "sql_migration_attempts",
  "resolvedContextAuthority": "server/_core/databaseAuthority/context.ts",
  "operationPolicy": "docs/database-authority/operation-policy.json",
  "connectionAuthority": "server/_core/databaseAuthority/connectionAuthority.ts",
  "worktreeLifecycleAuthority": "server/_core/databaseAuthority/lifecycle.ts",
  "worktreeProfileRelativeDirectory": ".config/property-listify/worktrees",
  "worktreeDatabasePrefix": "listify_wt_",
  "schemaCongruencyAuthority": "server/_core/databaseAuthority/schemaCongruency.ts",
  "readinessAuthority": "server/_core/databaseAuthority/readiness.ts",
  "connectionPathInventory": "docs/database-authority/connection-path-inventory.json",
  "continuationPackets": "docs/database-authority/database-authority-continuation-packets.md",
  "approvedLocalDatabaseName": "listify_local",
  "localEnvironmentTemplate": ".env.local.example",
  "machineLocalEnvironmentRelativePath": ".config/property-listify/local.env",
  "requiredLocalVariables": [
    "DATABASE_URL",
    "LOCAL_DEMO_AGENCY_PASSWORD",
    "JWT_SECRET",
    "APP_URL",
    "FRONTEND_URL",
    "VITE_API_URL",
    "VITE_API_BASE_URL"
  ],
  "approvedLocalHosts": ["127.0.0.1", "::1"],
  "approvedLocalCommands": [
    "db:authority:status",
    "db:authority:manifest",
    "db:authority:context",
    "db:worktree:create",
    "db:migrate:plan",
    "db:migrate:apply",
    "db:readiness",
    "db:schema:congruency",
    "db:local:start",
    "db:local:wait",
    "db:authority:service:start",
    "db:authority:service:wait",
    "db:authority:service:status",
    "db:authority:service:stop",
    "db:authority:service:recover",
    "db:reference:prepare",
    "db:reference:verify",
    "db:scenario:prepare",
    "db:scenario:verify"
  ],
  "destructiveLocalCommands": ["db:worktree:dispose"],
  "prohibitedCommandCategories": [
    "db:push and schema push",
    "schema generation outside an approved migration task",
    "manual DDL and retired schema executors",
    "unapproved remote, shared, staging, production, Railway, and TiDB targets",
    "all mutation of the quarantined current listify_local database"
  ],
  "localSeedEntrypoint": "server/_core/databaseAuthority/dataAdapters/canonicalGeography.ts",
  "localDataAuthorityStatus": "operation-specific-reference-and-scenario-adapters-only",
  "verificationEntrypoints": [
    "scripts/db-contract-verify.ts",
    "scripts/db-verify-distribution-schema.ts",
    "scripts/databaseAuthorityCli.ts"
  ],
  "consumerContractEntrypoint": "scripts/databaseAuthorityConsumerContract.ts",
  "staticAuthorityCheck": "scripts/databaseAuthorityCheck.ts",
  "agentEntryContract": "docs/database-authority/00-database-authority-agent-entry.md",
  "databaseChangeProtocol": "docs/database-authority/database-change-protocol.md",
  "migrationTreeAuthority": "docs/database-authority/migration-tree-authority.json",
  "residualUtilityAuthority": "docs/database-authority/residual-utility-authority.json",
  "localServicePathAuthority": "server/_core/databaseAuthority/localServicePaths.ts",
  "localServiceLifecycle": "scripts/local-db.sh",
  "localServiceDirectoryPattern": "/var/tmp/property-listify-<uid>/mysql-3307",
  "canonicalReferenceDataAdapter": "server/_core/databaseAuthority/dataAdapters/canonicalGeography.ts",
  "acceptanceScenarioAdapter": "server/_core/databaseAuthority/dataAdapters/searchToLeadScenario.ts"
}
