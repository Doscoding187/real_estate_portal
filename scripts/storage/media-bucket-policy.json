{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudFrontReadOnly",
      "Effect": "Allow",
      "Principal": { "Service": "cloudfront.amazonaws.com" },
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::listify-properties-sa/*",
      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": "arn:aws:cloudfront::914683204061:distribution/E3JNW2EP3Z3JSP"
        }
      }
    },
    {
      "Sid": "RequireTLS",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": ["arn:aws:s3:::listify-properties-sa", "arn:aws:s3:::listify-properties-sa/*"],
      "Condition": { "Bool": { "aws:SecureTransport": "false" } }
    }
  ]
}
